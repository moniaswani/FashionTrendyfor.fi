# macOS system files
.DS_Store

# Node.js dependencies
node_modules/

# Python model files and archives
*.pt
*.zip

# Ignore everything in dataimages
dataimages/*

# But keep these specific files/folders
!dataimages/logo.png
!dataimages/required_folder/
!dataimages/required_folder/**

# Python virtual environments
.venv/
venv/
fashint/lib/
pyenv.cfg

# Python bytecode
*.pyc
__pycache__/

share/*

images/*

output_segmented/*
.venv/
.claude/
__pycache__/
*.pyc
.DS_Store

# Excel workbooks (runway_metadata_schema*.xlsx etc.) - large, binary, and
# frequently regenerated/backed-up during data work; the real source of
# truth is DynamoDB, not these files, so they don't belong in git history.
*.xlsx
*.xls
*.xlsx.bak
*.xlsx.corrupt.bak
*.xlsx.corrupt-*.bak

# SAM build output - always regenerated by `sam build`, never hand-edited.
.aws-sam/

# Large working directories that don't belong in git history: old_src/ is
# superseded code kept around locally for reference, output_batches/ is
# disposable scraper output, ui_prototypes/ is the now-fully-ported (into
# project/) UI prototype - all kept on disk, none of them tracked.
old_src/
output_batches/
ui_prototypes/